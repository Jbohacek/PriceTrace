@page "/listings"
@using PriceTrace.Contracts.Models.ListingModels
@inject ListingApiClient ListingClient
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>All Listings</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1>All Listings</h1>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">Filters</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Min Price (Kč)</label>
                    <input type="number" class="form-control" @bind="minPrice" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Max Price (Kč)</label>
                    <input type="number" class="form-control" @bind="maxPrice" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Location</label>
                    <input type="text" class="form-control" @bind="location" placeholder="Search location..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Search Term</label>
                    <input type="text" class="form-control" @bind="searchTerm" placeholder="Search title/description..." />
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-3">
                    <label class="form-label">Sort By</label>
                    <select class="form-select" @bind="sortBy">
                        <option value="retrievedat">Retrieved Date</option>
                        <option value="price">Price</option>
                        <option value="title">Title</option>
                        <option value="viewcount">View Count</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Order</label>
                    <select class="form-select" @bind="sortDescending">
                        <option value="false">Ascending</option>
                        <option value="true">Descending</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Page Size</label>
                    <select class="form-select" @bind="pageSize">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
                <div class="col-md-5 d-flex align-items-end">
                    <button class="btn btn-primary me-2" @onclick="ApplyFilters">
                        <span class="bi bi-funnel"></span> Apply Filters
                    </button>
                    <button class="btn btn-secondary" @onclick="ResetFilters">
                        <span class="bi bi-x-circle"></span> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (listings.Count == 0)
    {
        <div class="alert alert-info">No listings found.</div>
    }
    else
    {
        <!-- Results info -->
        <div class="row mb-3">
            <div class="col">
                <p class="text-muted">
                    Showing @((currentPage - 1) * pageSize + 1) - @Math.Min(currentPage * pageSize, totalCount) of @totalCount listings
                </p>
            </div>
        </div>

        <!-- Listings Grid -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var listing in listings)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@listing.Title</h5>
                            <h6 class="card-subtitle mb-2">
                                <span class="badge @GetPriceBadgeClass(listing.Price)">
                                    @FormatPrice(listing.Price)
                                </span>
                            </h6>
                            @if (!string.IsNullOrEmpty(listing.Description))
                            {
                                <p class="card-text">
                                    <small class="text-muted">@GetTruncatedDescription(listing.Description)</small>
                                </p>
                            }
                            <div class="mb-2">
                                <small>
                                    <strong>Product:</strong> 
                                    <a href="/products/@listing.ProductId">@listing.ProductName</a>
                                </small>
                            </div>
                            @if (!string.IsNullOrEmpty(listing.Location))
                            {
                                <div class="mb-1">
                                    <small><span class="bi bi-geo-alt"></span> @listing.Location</small>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(listing.CreatorName))
                            {
                                <div class="mb-1">
                                    <small><span class="bi bi-person"></span> @listing.CreatorName</small>
                                </div>
                            }
                            @if (listing.ViewCount.HasValue)
                            {
                                <div class="mb-1">
                                    <small><span class="bi bi-eye"></span> @listing.ViewCount.Value views</small>
                                </div>
                            }
                            <div class="mb-2">
                                <small class="text-muted">
                                    Retrieved: @listing.RetrievedAt.ToString("g")
                                </small>
                            </div>
                        </div>
                        <div class="card-footer">
                            <a href="@listing.Url" target="_blank" class="btn btn-sm btn-primary w-100">
                                <span class="bi bi-box-arrow-up-right"></span> View Listing
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <nav aria-label="Listings pagination" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Previous</button>
                </li>
                
                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                {
                    var pageNumber = i;
                    <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                    </li>
                }
                
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
</div>

@code {
    private List<ListingResponse> listings = new();
    private bool isLoading = true;
    private string? errorMessage;
    
    // Filter parameters
    private decimal? minPrice;
    private decimal? maxPrice;
    private string? location;
    private string? searchTerm;
    private string sortBy = "retrievedat";
    private bool sortDescending = true;
    private int pageSize = 25;
    private int currentPage = 1;
    private int totalCount = 0;
    private int totalPages = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadListings();
    }

    private async Task LoadListings()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var request = new ListingFilterRequest(
                MinPrice: minPrice,
                MaxPrice: maxPrice,
                Location: location,
                SearchTerm: searchTerm,
                SortBy: sortBy,
                SortDescending: sortDescending,
                PageNumber: currentPage,
                PageSize: pageSize
            );

            var result = await ListingClient.FilterListingsAsync(request);
            
            if (result != null)
            {
                listings = result.Items.ToList();
                totalCount = result.TotalCount;
                totalPages = result.TotalPages;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load listings: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadListings();
    }

    private async Task ResetFilters()
    {
        minPrice = null;
        maxPrice = null;
        location = null;
        searchTerm = null;
        sortBy = "retrievedat";
        sortDescending = true;
        pageSize = 25;
        currentPage = 1;
        await LoadListings();
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadListings();
    }

    private string GetPriceBadgeClass(decimal price)
    {
        if (price == 0) return "bg-success";
        if (price == -1) return "bg-info";
        return "bg-primary";
    }

    private string FormatPrice(decimal price)
    {
        if (price == 0) return "Free";
        if (price == -1) return "By Agreement";
        return $"{price:N0} CZK";
    }

    private string GetTruncatedDescription(string description, int maxLength = 100)
    {
        if (string.IsNullOrEmpty(description)) return string.Empty;
        if (description.Length <= maxLength) return description;
        return description.Substring(0, maxLength) + "...";
    }
}
